{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub repository settings baseline",
  "description": "The schema of github/repository.yaml, the settings baseline of a repository that `devops repos onboard` applies (README.md, \"Repository template\"). Each key is the request body of one endpoint of the GitHub REST API. The field names and the allowed values come from the OpenAPI description of the API (github/rest-api-description). The schema refuses each field that it does not name, so a misspelled field fails.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "vulnerability_alerts",
    "private_vulnerability_reporting",
    "immutable_releases",
    "code_scanning_default_setup",
    "actions_workflow_permissions",
    "rulesets"
  ],
  "properties": {
    "repository": {
      "description": "PATCH /repos/{owner}/{repo}",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_squash_merge": { "type": "boolean" },
        "allow_merge_commit": { "type": "boolean" },
        "allow_rebase_merge": { "type": "boolean" },
        "squash_merge_commit_title": { "enum": ["PR_TITLE", "COMMIT_OR_PR_TITLE"] },
        "squash_merge_commit_message": { "enum": ["PR_BODY", "COMMIT_MESSAGES", "BLANK"] },
        "merge_commit_title": { "enum": ["PR_TITLE", "MERGE_MESSAGE"] },
        "merge_commit_message": { "enum": ["PR_BODY", "PR_TITLE", "BLANK"] },
        "allow_auto_merge": { "type": "boolean" },
        "allow_update_branch": { "type": "boolean" },
        "delete_branch_on_merge": { "type": "boolean" },
        "web_commit_signoff_required": { "type": "boolean" },
        "has_issues": { "type": "boolean" },
        "has_projects": { "type": "boolean" },
        "has_wiki": { "type": "boolean" },
        "security_and_analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "advanced_security": { "$ref": "#/$defs/status" },
            "code_security": { "$ref": "#/$defs/status" },
            "secret_scanning": { "$ref": "#/$defs/status" },
            "secret_scanning_push_protection": { "$ref": "#/$defs/status" },
            "secret_scanning_ai_detection": { "$ref": "#/$defs/status" },
            "secret_scanning_non_provider_patterns": { "$ref": "#/$defs/status" }
          }
        }
      }
    },
    "vulnerability_alerts": {
      "description": "PUT (true) or DELETE (false) /repos/{owner}/{repo}/vulnerability-alerts",
      "type": "boolean"
    },
    "private_vulnerability_reporting": {
      "description": "PUT (true) or DELETE (false) /repos/{owner}/{repo}/private-vulnerability-reporting",
      "type": "boolean"
    },
    "immutable_releases": {
      "description": "PUT (true) or DELETE (false) /repos/{owner}/{repo}/immutable-releases",
      "type": "boolean"
    },
    "code_scanning_default_setup": {
      "description": "PATCH /repos/{owner}/{repo}/code-scanning/default-setup",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["configured", "not-configured"] },
        "runner_type": { "enum": ["standard", "labeled"] },
        "runner_label": { "type": ["string", "null"] },
        "query_suite": { "enum": ["default", "extended"] },
        "threat_model": { "enum": ["remote", "remote_and_local"] },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "actions",
              "c-cpp",
              "csharp",
              "go",
              "java-kotlin",
              "javascript-typescript",
              "python",
              "ruby",
              "swift"
            ]
          }
        }
      }
    },
    "actions_workflow_permissions": {
      "description": "PUT /repos/{owner}/{repo}/actions/permissions/workflow",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_workflow_permissions": { "enum": ["read", "write"] },
        "can_approve_pull_request_reviews": { "type": "boolean" }
      }
    },
    "rulesets": {
      "description": "POST /repos/{owner}/{repo}/rulesets, or PUT /repos/{owner}/{repo}/rulesets/{ruleset_id} for a ruleset of the same name",
      "type": "array",
      "items": { "$ref": "#/$defs/ruleset" }
    },
    "environments": {
      "description": "PUT /repos/{owner}/{repo}/environments/{name}, POST .../deployment-branch-policies for each branch policy, and the variables and secrets of the environment by name",
      "type": "array",
      "items": { "$ref": "#/$defs/environment" }
    }
  },
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["enabled", "disabled"] }
      }
    },
    "name": {
      "description": "The name of a variable or a secret of GitHub Actions",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": { "pattern": "^GITHUB_" }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enforcement"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "enum": ["branch", "tag", "push"] },
        "enforcement": { "enum": ["disabled", "active", "evaluate"] },
        "bypass_actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_type"],
            "properties": {
              "actor_id": { "type": ["integer", "null"] },
              "actor_type": {
                "enum": ["Integration", "OrganizationAdmin", "RepositoryRole", "Team", "DeployKey", "User"]
              },
              "bypass_mode": { "enum": ["always", "pull_request", "exempt"] }
            }
          }
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref_name": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "include": { "type": "array", "items": { "type": "string" } },
                "exclude": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "creation",
            "update",
            "deletion",
            "non_fast_forward",
            "required_linear_history",
            "required_signatures",
            "pull_request",
            "required_status_checks",
            "code_scanning",
            "code_quality"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "creation",
                  "update",
                  "deletion",
                  "non_fast_forward",
                  "required_linear_history",
                  "required_signatures"
                ]
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "properties": { "type": true }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pull_request" } } },
          "then": {
            "additionalProperties": false,
            "required": ["parameters"],
            "properties": {
              "type": true,
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dismiss_stale_reviews_on_push",
                  "require_code_owner_review",
                  "require_last_push_approval",
                  "required_approving_review_count",
                  "required_review_thread_resolution"
                ],
                "properties": {
                  "allowed_merge_methods": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["merge", "squash", "rebase"] }
                  },
                  "dismiss_stale_reviews_on_push": { "type": "boolean" },
                  "require_code_owner_review": { "type": "boolean" },
                  "require_last_push_approval": { "type": "boolean" },
                  "required_approving_review_count": { "type": "integer", "minimum": 0, "maximum": 10 },
                  "required_review_thread_resolution": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "required_status_checks" } } },
          "then": {
            "additionalProperties": false,
            "required": ["parameters"],
            "properties": {
              "type": true,
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["required_status_checks", "strict_required_status_checks_policy"],
                "properties": {
                  "do_not_enforce_on_create": { "type": "boolean" },
                  "required_status_checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["context"],
                      "properties": {
                        "context": { "type": "string", "minLength": 1 },
                        "integration_id": { "type": "integer" }
                      }
                    }
                  },
                  "strict_required_status_checks_policy": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "code_scanning" } } },
          "then": {
            "additionalProperties": false,
            "required": ["parameters"],
            "properties": {
              "type": true,
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code_scanning_tools"],
                "properties": {
                  "code_scanning_tools": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["alerts_threshold", "security_alerts_threshold", "tool"],
                      "properties": {
                        "alerts_threshold": { "enum": ["none", "errors", "errors_and_warnings", "all"] },
                        "security_alerts_threshold": {
                          "enum": ["none", "critical", "high_or_higher", "medium_or_higher", "all"]
                        },
                        "tool": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "code_quality" } } },
          "then": {
            "additionalProperties": false,
            "required": ["parameters"],
            "properties": {
              "type": true,
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["severity"],
                "properties": {
                  "severity": { "enum": ["errors", "warnings", "notes", "all"] }
                }
              }
            }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "wait_timer": { "type": "integer", "minimum": 0, "maximum": 43200 },
        "prevent_self_review": { "type": "boolean" },
        "deployment_branch_policy": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["protected_branches", "custom_branch_policies"],
          "properties": {
            "protected_branches": { "type": "boolean" },
            "custom_branch_policies": { "type": "boolean" }
          }
        },
        "branch_policies": {
          "description": "POST /repos/{owner}/{repo}/environments/{name}/deployment-branch-policies. GitHub reads them only when custom_branch_policies is true.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "enum": ["branch", "tag"] }
            }
          }
        },
        "variables": {
          "description": "The names of the variables of the environment. The file holds no value: the command reads each value from its config.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "secrets": {
          "description": "The names of the secrets of the environment. The file holds no value: the command reads each value from its config or its keyring, and GitHub never returns one.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    }
  }
}
