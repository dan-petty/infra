# The labels of this repository only. `devops repos onboard` adds each label that is missing on
# GitHub. The workflow labels, such as type/* and status/*, come from devops-cli. Intake gives an
# issue the scope/* label of its Conventional Commit scope, and the PR title check accepts each
# scope of this file. In every repository it also accepts ci, deps, docs, main and spec, with or
# without a label. Each scope/* label is gray (DCDCD6), as in devops-cli. The template writes this
# file from the answers scopes and scope_descriptions: change a scope or its description with
# `copier update --data scopes=<scopes>` or `--data scope_descriptions=<mapping>`, not here.
{%- set template_scopes = {
  'ci': 'GitHub Actions workflows and pre-commit hooks',
  'deps': 'Dependency pins and the updates of Renovate',
  'docs': 'README and other documents',
} %}
{%- set own_scopes = scopes.split(',') | map('trim') | reject('equalto', '')
  | reject('in', template_scopes) | unique | list %}
{%- for scope in template_scopes | list + own_scopes %}

- name: "scope/{{ scope }}"
  color: "DCDCD6"
  description: "{{ scope_descriptions[scope] | default(template_scopes[scope]
    | default('The area ' ~ scope ~ ' of this repository')) }}"
{%- endfor %}
{%- if release_flow %}

# release-please finds its release pull request by these labels.
- name: "autorelease: pending"
  color: "DCDCD6"
  description: "The release pull request that release-please keeps open"

- name: "autorelease: tagged"
  color: "DCDCD6"
  description: "A release pull request whose release release-please created"
{%- endif %}
