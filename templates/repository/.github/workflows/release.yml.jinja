name: Release

# release-please makes each release of this repository. On each push to main, the reusable workflow
# release.yml of infra opens or updates one release pull request and turns on auto-merge. When it
# merges after its checks pass, the next run creates the tag vX.Y.Z and its GitHub release. Its job
# runs in the environment release, which holds the variable RELEASE_APP_CLIENT_ID and the secret
# RELEASE_APP_PRIVATE_KEY of the release App, and only main deploys to it (github/repository.yaml).
# The repository holds no secret of its own.
# The caller must pass the secret by name, and the job gets the value of the secret of the
# environment. The caller passes no other secret: no `secrets: inherit`.
# The caller pins the commit of the release tag of infra that rendered this file, with the tag in a
# comment: the form of a digest pin of the github-actions manager of Renovate. `copier update`
# changes both.
on:
  push:
    branches:
      - main

permissions: {}

concurrency:
  group: release
  cancel-in-progress: false

jobs:
  release:
    name: Release
    uses: dan-petty/infra/.github/workflows/release.yml@{{ _copier_conf.vcs_ref_hash or vcs_ref_hash_missing | mandatory("Copier gives no commit of the template. Render a git repository, such as a release tag of https://github.com/dan-petty/infra.git.") }} # {{ infra_ref }}
    # The token of the release App writes the release; the job token gets no permission.
    permissions: {}
    secrets:
      RELEASE_APP_PRIVATE_KEY: {% raw %}${{ secrets.RELEASE_APP_PRIVATE_KEY }}{% endraw %}
