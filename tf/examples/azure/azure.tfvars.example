# The values of a test for tf/examples/azure. A consumer copies this file and sets its own values.
# The network and the authorized range use the RFC 5737 blocks, so the file holds no private
# address. A consumer sets api_server_authorized_ip_ranges to the public ranges of its operators.
resource_group_name             = "rg-example-aks"
location                        = "eastus"
cluster_name                    = "example-aks"
dns_prefix                      = "example-aks"
node_vm_size                    = "Standard_D4s_v5"
node_count                      = 3
min_node_count                  = 2
max_node_count                  = 5
vnet_address_space              = ["192.0.2.0/24"]
subnet_address_prefix           = "192.0.2.0/25"
api_server_authorized_ip_ranges = ["203.0.113.0/24"]
tags = {
  Environment = "example"
  ManagedBy   = "opentofu"
}
